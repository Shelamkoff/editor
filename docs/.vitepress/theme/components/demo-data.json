      "dataVersion": 2
    },
    {
      "id": "principles",
      "type": "list",
      "data": {
        "items": [
          {
            "id": "principle-1",
            "text": "One completed interaction is one history step"
          },
          {
            "id": "principle-2",
            "text": "Each block owns serializable data"
          },
          {
            "id": "principle-3",
            "text": "Renderers stay independent from editor UI"
          }
        ],
        "style": "unordered"
      },
      "dataVersion": 2
    },
    {
      "id": "quote",
      "type": "quote",
      "data": {
        "text": "Plugins extend contracts, not internal managers.",
        "caption": "Architecture rule"
      },
      "dataVersion": 1
    },
    {
